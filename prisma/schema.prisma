// Prisma schema for the WarEra Discord bot.
//
// Persistence model: the bot keeps every server's config in an in-memory cache
// (ServerConfigManager) as the runtime source of truth, and mirrors it here for
// durability. Each feature block of ServerConfig is stored as its own JSON-encoded
// column (String, since the SQLite connector has no native JSON type on this Prisma
// version) so a server's row round-trips exactly to/from the nested config object,
// while each feature stays independently inspectable in the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One row per Discord server (guild). Columns mirror the feature blocks of
/// `ServerConfig` in src/config/config.ts.
model Server {
  id                 String   @id
  bountyBattles      String?
  mercenaryContracts String?
  reports            String?
  userTracking       String?
  countryTracking    String?
  proxyTracking      String?
  countryGroups      String?
  spectre            String?
  leaderboard        String?
  muDirectory        String?
  autorole           String?
  updatedAt          DateTime @updatedAt
}

/// A Discord member linked to a WarEra account, per server. Grows with
/// membership, so it lives in its own table rather than the JSON blob.
model LinkedUser {
  serverId       String
  discordUserId  String
  wareraUserId   String
  linkedAt       DateTime  @default(now())
  muNoticeSentAt DateTime?

  @@id([serverId, discordUserId])
  @@unique([serverId, wareraUserId])
}

/// A link request awaiting staff approval (user's country not allowlisted).
model PendingLink {
  serverId        String
  discordUserId   String
  wareraUserId    String
  wareraUsername  String
  countryId       String?
  reviewChannelId String?
  reviewMessageId String?
  createdAt       DateTime @default(now())

  @@id([serverId, discordUserId])
  @@unique([serverId, wareraUserId])
}

/// An in-flight company-rename verification (short-lived; rows expire).
model PendingVerification {
  serverId       String
  discordUserId  String
  wareraUserId   String
  wareraUsername String
  code           String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@id([serverId, discordUserId])
}

/// Weekly damage leaderboard snapshots (replaces the per-server CSV files under
/// data/weekly-damage/). `kind` is "users" or "mu"; `week` is the week-ending key.
model WeeklyDamageSnapshot {
  id        Int      @id @default(autoincrement())
  serverId  String
  kind      String
  week      String
  csv       String
  createdAt DateTime @default(now())

  @@unique([serverId, kind, week])
  @@index([serverId, kind])
}
