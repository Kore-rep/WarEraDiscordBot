# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Polling Configuration
# How often (in minutes) the bot should make API requests
POLLING_INTERVAL_MINUTES=1

# Database (SQLite via Prisma)
# Path is resolved relative to prisma/schema.prisma, so this points at <repo>/data/bot.db
DATABASE_URL="file:../data/bot.db"

# Logging
# Minimum level to emit: DEBUG, INFO, WARN, or ERROR (default: DEBUG)
# LOG_LEVEL=INFO

# API Configuration
# Base URL for the API (optional, may be set in SDK)
API_BASE_URL=https://api2.warera.io/trpc