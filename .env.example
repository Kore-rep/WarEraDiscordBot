# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID where the bot will send messages
# Right-click on the channel in Discord and select "Copy ID" (Developer Mode must be enabled)
DISCORD_CHANNEL_ID=your_channel_id_here

# Polling Configuration
# How often (in minutes) the bot should make API requests
POLLING_INTERVAL_MINUTES=5

# API Configuration
# Base URL for the API (optional, may be set in SDK)
API_BASE_URL=https://api2.warera.io/trpc

# Role IDs to Mention
# Comma-separated list of Discord Role IDs to Mention
# You can get role IDs by enabling Developer Mode in Discord and right-clicking users
ROLE_IDS_TO_MENTION=123456789012345678,987654321098765432
