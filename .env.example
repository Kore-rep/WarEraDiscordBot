# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Polling Configuration
# How often (in minutes) the bot should make API requests
POLLING_INTERVAL_MINUTES=1

# Database (SQLite via Prisma)
# Path is resolved relative to prisma/schema.prisma, so this points at <repo>/data/bot.db
DATABASE_URL="file:../data/bot.db"

# Logging
# Minimum level to emit: DEBUG, INFO, WARN, or ERROR (default: DEBUG)
# LOG_LEVEL=INFO

# API Configuration
# Base URL for the API (optional, may be set in SDK)
API_BASE_URL=https://api2.warera.io/trpc

# Optional encrypted whole-database backups. See docs/BACKUPS.md.
BACKUP_ENABLED=false
BACKUP_INTERVAL_MINUTES=60
# Copy the S3 API endpoint from your existing bucket's settings.
R2_ENDPOINT=
R2_BUCKET=
R2_BACKUP_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Generate with: npm run --silent backup:keygen
# Keep an independent copy: losing this key makes backups unrecoverable.
BACKUP_ENCRYPTION_KEY=
# Secrets can instead be mounted files; do not set both forms for the same value.
# R2_ACCESS_KEY_ID_FILE=/run/secrets/r2_access_key_id
# R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2_secret_access_key
# BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
